#!/bin/sh
set -eu

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
settings_file="$config_home/noctalia/settings.json"
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
preset_file=${1:-"$(dirname "$script_dir")/noctalia/bar.json"}
settings_tmp=$(mktemp "$(dirname "$settings_file")/.settings.XXXXXX")
trap 'rm -f "$settings_tmp"' EXIT HUP INT TERM

# Preserve every non-bar setting and all per-widget options not listed in the
# preset. Each widget is looked up by ID, so nothing else is reset.
jq -e --slurpfile preset "$preset_file" '
  ($preset[0]) as $p
  | ([.bar.widgets.left[], .bar.widgets.center[], .bar.widgets.right[]]) as $existing
  | .bar += $p.bar
  | .bar.widgets = ($p.layout | with_entries(
      .value |= map(. as $id
        | ($existing | map(select(.id == $id)) | .[0] // $p.widgetDefaults[$id] // error("Missing Noctalia widget: " + $id))
        | . + ($p.widgetOverrides[$id] // {}))
    ))
' "$settings_file" > "$settings_tmp"

chmod --reference="$settings_file" "$settings_tmp"
mv -f "$settings_tmp" "$settings_file"
trap - EXIT HUP INT TERM
