#!/bin/sh
# CHIIKAWA_LOCK_PREVIEW=1 opens a preview window instead of locking.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(dirname "$script_dir")
cache_dir=${XDG_CACHE_HOME:-"$HOME/.cache"}/chiikawa-lock

screen=$(niri msg --json focused-output 2>/dev/null | jq -r '.name // empty' || true)
wallpaper=$(timeout 3 noctalia-shell ipc call wallpaper get "${screen:-all}" 2>/dev/null || true)
[ -n "$wallpaper" ] && [ -f "$wallpaper" ] || wallpaper="$root/wallpaper/chiikawa.jpg"

mkdir -p "$cache_dir"
cached="$cache_dir/background.jpg"
sharp="$cache_dir/background-sharp.jpg"
if [ ! -f "$cached" ] || [ ! -f "$sharp" ] || [ "$wallpaper" -nt "$cached" ]; then
  tmp=$(mktemp "$cache_dir/.background.XXXXXX.jpg")
  tmp_sharp=$(mktemp "$cache_dir/.sharp.XXXXXX.jpg")
  trap 'rm -f "$tmp" "$tmp_sharp"' EXIT HUP INT TERM
  # ImageMagick 7 is `magick`; 6 (Debian, Ubuntu) only has `convert`.
  im=magick
  command -v magick >/dev/null 2>&1 || im=convert
  "$im" "$wallpaper" -resize '1920x1200^' -gravity center -extent 1920x1200 \
    -quality 88 "$tmp_sharp"
  "$im" "$tmp_sharp" -blur 0x24 -quality 82 "$tmp"
  mv -f "$tmp" "$cached"
  mv -f "$tmp_sharp" "$sharp"
  trap - EXIT HUP INT TERM
fi
export CHIIKAWA_LOCK_BG="file://$cached"
export CHIIKAWA_LOCK_SHARP="file://$sharp"

# Loaded by file URL from outside Quickshell's config folder, so its relative
# import of ../theme/figures resolves.
export CHIIKAWA_LOCK_VIEW="file://$root/lockscreen/ChiikawaLockView.qml"

# A second invocation must not create a competing session lock.
exec flock -n "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/chiikawa-lock.lock" \
  quickshell --path "$root/lockscreen/shell/shell.qml"
