#!/bin/sh
# Try the rice in a nested niri window without touching your own setup: it
# gets its own home, runtime dir and D-Bus session, and install.sh runs
# against that. Inside the window Mod is Alt. --reset starts from scratch.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(dirname "$script_dir")

say() { printf 'chiikawa preview: %s\n' "$*"; }
die() { printf 'chiikawa preview: %s\n' "$*" >&2; exit 1; }

# Second stage, spawned by the nested niri.
if [ "${1:-}" = --inside ]; then
  settings_file="$XDG_CONFIG_HOME/noctalia/settings.json"
  if [ ! -f "$settings_file" ]; then
    # install.sh wants the settings Noctalia writes on its first start.
    setsid -f noctalia-shell -d >/dev/null 2>&1 < /dev/null
    for _ in $(seq 1 100); do
      [ -f "$settings_file" ] && break
      sleep 0.2
    done
  fi
  exec "$root/install.sh" > "$HOME/install.log" 2>&1
fi

for cmd in niri noctalia-shell dbus-run-session; do
  command -v "$cmd" >/dev/null 2>&1 || die "missing '$cmd'"
done
[ -n "${WAYLAND_DISPLAY:-}" ] && [ -n "${XDG_RUNTIME_DIR:-}" ] \
  || die "run this from inside your Wayland session"

preview=${XDG_STATE_HOME:-"$HOME/.local/state"}/chiikawa-rice/preview
if [ "${1:-}" = --reset ]; then
  rm -rf "$preview"
fi
home="$preview/home"
runtime="$preview/run"
mkdir -p "$home/.config/niri" "$runtime"
chmod 700 "$runtime"

# install.sh adds the rice's includes to the end of this.
niri_config="$home/.config/niri/config.kdl"
if [ ! -f "$niri_config" ]; then
  terminal=ghostty
  command -v ghostty >/dev/null 2>&1 || terminal=foot
  cat > "$niri_config" <<EOF
// Preview session from $root/scripts/preview
spawn-at-startup "$root/scripts/preview" "--inside"
hotkey-overlay { skip-at-startup; }

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Return hotkey-overlay-title="Terminal" { spawn "$terminal"; }
    Mod+E hotkey-overlay-title="Dolphin" { spawn "dolphin"; }
    Mod+O repeat=false { toggle-overview; }
    Mod+Q repeat=false { close-window; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-workspace-up; }
    Mod+Down { focus-workspace-down; }
    Mod+Shift+D hotkey-overlay-title="Toggle dark mode" { spawn "noctalia-shell" "ipc" "call" "darkMode" "toggle"; }
    Mod+Shift+E { quit skip-confirmation=true; }
}
EOF
fi

host_display=$WAYLAND_DISPLAY
case $host_display in /*) ;; *) host_display="$XDG_RUNTIME_DIR/$host_display" ;; esac

say "opening a niri window; Alt is Mod in there (Alt+Shift+/ lists the keys)"
say "dark mode: the control center tile or Alt+Shift+D; Alt+Shift+E closes it"
say "the preview lives in $preview (--reset wipes it)"

# Audio still goes to your PipeWire; everything else stays in the preview.
env -u NIRI_SOCKET -u DISPLAY -u DBUS_SESSION_BUS_ADDRESS \
  HOME="$home" \
  XDG_CONFIG_HOME="$home/.config" \
  XDG_DATA_HOME="$home/.local/share" \
  XDG_CACHE_HOME="$home/.cache" \
  XDG_STATE_HOME="$home/.local/state" \
  XDG_RUNTIME_DIR="$runtime" \
  WAYLAND_DISPLAY="$host_display" \
  PIPEWIRE_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
  PULSE_SERVER="unix:$XDG_RUNTIME_DIR/pulse/native" \
  dbus-run-session -- niri
